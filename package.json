{
  "name": "dsh-plugin-chatgpt",
  "version": "1.1.4",
  "type": "module",
  "description": "ChatGPT subscription models and native sign-in for DeepSeek Harness 0.2.2",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "src",
    "scripts",
    "model-config.json",
    "usage.js",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremytenjo/dsh-plugin-chatgpt.git"
  },
  "homepage": "https://github.com/jeremytenjo/dsh-plugin-chatgpt#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "chatgpt",
    "codex"
  ],
  "author": "Jeremy Tenjo"
}
